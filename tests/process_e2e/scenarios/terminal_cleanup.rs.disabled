//! E2E-07 scenario tests - terminal cleanup verification
//!
//! Tests that the application properly restores terminal state on exit,
//! including alternate screen buffer and raw mode.

use crate::harness::*;
use std::cell::RefCell;

#[test]
fn exit_restores_terminal_from_onboarding() {
    // Arrange: Create isolated test environment (empty vault directory)
    let env = TestEnv::new();
    assert!(!env.vault_dir.exists(), "Vault directory should not exist initially");

    // Create a logger to capture all PTY output
    let logger = Cursor::new(Vec::new());

    // Act: Spawn the ok binary with logging enabled
    let cmd = env.command();
    let raw_session = spawn_ok(&env).expect("Failed to spawn ok binary");
    let mut session = expectrl::session::log(raw_session, logger).expect("Failed to enable logging");

    // Act & Assert: Wait for the onboarding/welcome screen
    let welcome_patterns = ["OpenKeyring", "Welcome", "Create", "Import", "oak-keyring"];
    let mut found_pattern = None;

    for pattern in &welcome_patterns {
        match wait_screen_contains(&mut session, pattern, 5) {
            Ok(_) => {
                found_pattern = Some(pattern);
                break;
            }
            Err(_) => continue,
        }
    }

    let found = found_pattern.unwrap_or_else(|| {
        let screen = read_screen(&mut session);
        panic!(
            "No welcome pattern found. Current screen:\n{}\n\
             Looked for patterns: {:?}",
            screen, welcome_patterns
        );
    });

    println!("Found welcome pattern: '{}'", found);

    // Act: Send Esc key to exit the application
    send_key(&mut session, "Esc").expect("Failed to send Esc key");

    // Wait for the app to exit
    std::time::Duration::from_secs(2);

    // Assert: Clean exit with exit code 0
    assert_clean_exit(&mut session, 5);

    // Extract the logged data
    let logged_output = session.get_ref().get_ref();
    let all_bytes = logged_output.as_ref();

    println!("Total bytes logged: {}", all_bytes.len());

    // Convert to string for pattern matching
    let raw_output = String::from_utf8_lossy(all_bytes);

    // Check for terminal cleanup sequences that crossterm should emit on exit:
    // 1. \x1b[?1049l - Leave alternate screen buffer (most important)
    // 2. \x1b[?1000l - Disable mouse tracking
    // 3. \x1b[?25h - Show cursor
    let leave_alternate_screen = "\x1b[?1049l";
    let disable_mouse_tracking = "\x1b[?1000l";
    let show_cursor = "\x1b[?25h";

    let has_alternate_screen_cleanup = raw_output.contains(leave_alternate_screen);
    let has_mouse_cleanup = raw_output.contains(disable_mouse_tracking);
    let has_cursor_cleanup = raw_output.contains(show_cursor);

    println!(
        "Raw PTY output (hex, first 500 bytes): {:?}",
        all_bytes.iter()
            .take(500)
            .map(|b| format!("{:02x}", b))
            .collect::<Vec<_>>()
            .join(" ")
    );
    println!(
        "Raw PTY output (escaped, first 500 chars): {}",
        raw_output.chars().take(500).collect::<String>().escape_debug().collect::<String>()
    );

    // At minimum, the alternate screen cleanup should be present
    assert!(
        has_alternate_screen_cleanup,
        "Expected terminal cleanup sequence '{}' not found in PTY output.\n\
         This indicates the terminal may not be properly restored on exit.\n\
         Raw output: {}",
        leave_alternate_screen.escape_debug(),
        raw_output.escape_debug().collect::<String>()
    );

    // Additional cleanup sequences are good to have but not strictly required
    if has_mouse_cleanup {
        println!("✓ Mouse tracking cleanup found");
    } else {
        println!("⊘ Mouse tracking cleanup not found (may be version-dependent)");
    }

    if has_cursor_cleanup {
        println!("✓ Cursor visibility restoration found");
    } else {
        println!("⊘ Cursor visibility restoration not found (may be version-dependent)");
    }

    println!("✓ Terminal cleanup verified: alternate screen buffer restored");
}
