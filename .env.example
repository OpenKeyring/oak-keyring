# Google OAuth2 credentials (obtain from Google Cloud Console)
# Copy to .env and fill in real values:
#   cp .env.example .env
#   Edit .env and fill in real client_id and client_secret
OAK_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAK_GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
